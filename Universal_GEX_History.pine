        20260526 => [17.0, "GEX: $15.6M | D: Δ-0.07", 15.0, "GEX: $25.0M | D: Δ-0.09", float(na), 0.0, "15.0: $-18.3M, Δ-0.09\n17.0: $8.3M, Δ-0.07\n14.5: $-6.9M, Δ-0.14\n18.0: $6.8M, Δ0.02\n14.0: $-5.4M, Δ-0.12\n16.5: $5.4M, Δ-0.03"]
        20260527 => [16.0, "GEX: $21.1M | D: Δ0.06", 15.0, "GEX: $23.3M | D: Δ-0.00", 16.75, 0.1523069562758474, "15.0: $-16.7M, Δ-0.00\n16.5: $15.2M, Δ0.15\n17.0: $11.9M, Δ-0.01\n18.0: $8.4M, Δ0.05\n17.5: $5.5M, Δ0.06\n14.0: $-5.2M, Δ-0.08\n14.5: $-4.6M, Δ-0.01"]
        => [float(na), "", float(na), "", float(na), 0.0, ""]

// --- Array Functions ---

f_arrays_BBAI() =>
    [array.from(5.0, 4.5, 4.0), array.from(30, 18, 9), array.from(1, 1, 1), array.from('[$7.0M, Δ0.13]', '[$4.3M, Δ0.19]', '[$2.1M, Δ0.23]')]

f_arrays_BITO() =>
    [array.from(11.0, 10.0, 10.5), array.from(30, 29, 25), array.from(1, -1, -1), array.from('[$3.2M, Δ-0.04]', '[$-3.2M, Δ0.05]', '[$-2.7M, Δ-0.49]')]

