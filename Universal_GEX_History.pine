    [array.from(9.0, 10.0, 8.5), array.from(30, 10, 10), array.from(-1, 1, -1), array.from('[$-4.9M, Δ-0.28]', '[$1.7M, Δ-0.43]', '[$-1.7M, Δ-0.03]')]

